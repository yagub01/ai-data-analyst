# Copy this file to .env.local and fill in your key.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Set on public deployments: visitors must enter this code before the AI
# features work. Leave unset for local use.
# ACCESS_CODE=

# Optional: override the model (default: claude-sonnet-5-5).
# claude-opus-5-5 is the most capable, at about twice the price.
# AI_DATA_ANALYST_MODEL=claude-opus-5-5
